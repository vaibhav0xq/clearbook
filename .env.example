# Clearbook environment. Copy to .env and fill in what you have.
# Every key is optional except DATABASE_URL. A missing key turns the matching
# source into a labelled fallback, it never breaks the app.

# PostgreSQL connection string. Required by the API server.
DATABASE_URL=postgres://user:password@localhost:5432/clearbook

# Solana RPC used by the server for indexing and account reads.
# Leave both empty to use the public mainnet endpoint (slow, rate limited).
# SOLANA_RPC_URL takes priority. HELIUS_API_KEY builds a Helius RPC URL.
SOLANA_RPC_URL=
HELIUS_API_KEY=

# RPC the browser may use to broadcast signed transactions when a wallet
# cannot send them itself. Must not contain a private key.
VITE_SOLANA_RPC_URL=

# Pyth Pro (Lazer) access token for equity reference prices.
# Without it marks come from Jupiter and PreStocks and are labelled as fallback.
PYTH_API_KEY=
# Override the Pyth Pro base URL if you use a different endpoint.
PYTH_LAZER_URL=

# Public URL of the app, used in statement footers and PDF links.
APP_URL=

# Solana cluster label. Only mainnet-beta has tokenized stocks.
SOLANA_CLUSTER=mainnet-beta

# Maximum signatures read per wallet during indexing. Higher is deeper and slower.
INDEXER_MAX_SIGNATURES=400

# Local development outside Replit: forward /api from the Vite dev server to the API.
# API_PROXY_TARGET=http://localhost:8080

# API server log level (pino): debug, info, warn, error.
LOG_LEVEL=info
